# 后台管理账号密码（建议在 Vercel Project Settings -> Environment Variables 中配置）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password
AUTH_SECRET=replace-with-random-64-char-hex-secret

# Turso 云端数据库（在 Vercel 环境变量中配置，后台界面不显示）
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=eyJ...

# Backblaze B2 对象存储（建议使用单桶权限 Application Key）
B2_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET_NAME=blog-dcl
B2_BUCKET_ID=
# 可选：自定义公有读域名（留空则自动通过 /api/media/... 安全签名输出）
B2_PUBLIC_URL=
